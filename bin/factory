#!/usr/bin/env bash
# factory: drive Claude across your side projects from the terminal.
#
#   factory add <alias> <owner/repo>       register a project (writes projects/<alias>/project.env)
#   factory install <alias>                open a PR that wires the project into the factory
#   factory secret <alias|all>             store CLAUDE_CODE_OAUTH_TOKEN as a repo secret
#   factory doctor <alias|all>             check secret, label, and workflows are in place
#   factory task <alias> "what to do" [details]   file an issue Claude picks up and turns into a PR
#   factory status [alias]                 Claude's open issues and PRs across projects
#   factory list                           registered projects
#
# Run the agent locally (same plugin commands GitHub Actions runs; nothing is committed or pushed):
#   factory run <alias|dir> "what to do"   implement on a disposable copy, then audit + verify
#   factory fix-ci <alias|dir> <log>        fix a failing CI log on a disposable copy
#   factory review <alias|dir>              review uncommitted changes in a directory
#   factory night <alias> [--trial]        the project's NIGHTLY routine in ship mode (what the Night shift
#                                          workflow runs); skips while a claude/night-* PR is still open
#     options: --from DIR (copy this local checkout instead of cloning), --model M, --max-turns N,
#              --ship (work on a fresh GitHub clone and let the agent push + open a PR)
#
# Needs: gh (logged in), git, claude. `alias` is a directory name under projects/, or owner/repo.
set -euo pipefail

FACTORY_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
PROJECTS_DIR="$FACTORY_DIR/projects"
TEMPLATES_DIR="$FACTORY_DIR/templates"
LABEL=claude

die() { echo "factory: $*" >&2; exit 1; }
need_gh() { command -v gh >/dev/null || die "install the GitHub CLI: https://cli.github.com"; }
info() { echo "==> $*"; }

aliases() { for d in "$PROJECTS_DIR"/*/; do [ -f "$d/project.env" ] && basename "$d"; done; }

# Sets REPO, CI_WORKFLOW, SETUP, INSTALL_CI, ALIAS, PROJECT_DIR and NIGHTLY* for an alias or owner/repo.
load() {
  REPO="" CI_WORKFLOW="CI" SETUP="" INSTALL_CI="" ALIAS="$1" PROJECT_DIR=""
  NIGHTLY="" NIGHTLY_MODEL="" NIGHTLY_MAX_TURNS=""
  if [ -f "$PROJECTS_DIR/$1/project.env" ]; then
    PROJECT_DIR="$PROJECTS_DIR/$1"
    # shellcheck disable=SC1091
    . "$PROJECT_DIR/project.env"
  elif [[ "$1" == */* ]]; then
    REPO="$1" ALIAS="${1#*/}" INSTALL_CI=1
  else
    die "unknown project '$1' (known: $(aliases | tr '\n' ' '))"
  fi
  [ -n "$REPO" ] || die "$1: project.env has no REPO"
}

targets() { if [ "${1:-all}" = all ]; then aliases; else echo "$1"; fi; }

cmd_list() {
  for a in $(aliases); do load "$a"; printf '%-20s %s\n' "$a" "$REPO"; done
}

cmd_add() {
  [ $# -eq 2 ] || die "usage: factory add <alias> <owner/repo>"
  local dir="$PROJECTS_DIR/$1"
  [ -e "$dir" ] && die "$dir already exists"
  gh repo view "$2" --json name >/dev/null || die "can't see $2 with gh"
  mkdir -p "$dir"
  local ci="CI" install_ci=1
  if gh api "repos/$2/contents/.github/workflows" >/dev/null 2>&1; then
    echo "Existing workflows in $2:"
    gh api "repos/$2/actions/workflows" --jq '.workflows[] | "  - " + .name'
    read -r -p "Name of its CI workflow (blank to install the factory's generic CI): " ci
    if [ -n "$ci" ]; then install_ci=""; else ci="CI"; fi
  fi
  {
    echo "REPO=$2"
    echo "CI_WORKFLOW=\"$ci\""
    [ -n "$install_ci" ] && echo "INSTALL_CI=1"
  } > "$dir/project.env"
  info "wrote $dir/project.env. Optionally add $dir/CLAUDE.md, then: factory install $1"
}

# Copies the factory files into the current directory (a checkout of the project): the Factory
# workflow, generic CI when the project has none, CLAUDE.md, and the cloud-session hook.
# Existing CLAUDE.md and .claude/ files are left alone.
overlay() {
  mkdir -p .github/workflows
  sed -e "s|__CI_WORKFLOW__|$CI_WORKFLOW|" "$TEMPLATES_DIR/workflows/factory.yml" > .github/workflows/factory.yml
  if [ -n "$SETUP" ]; then
    sed -i.bak -e "s|__SETUP__|$SETUP|" .github/workflows/factory.yml
  else
    # Use the reusable workflow's default setup (npm ci when there's a lockfile).
    sed -i.bak -e '/__SETUP__/d' .github/workflows/factory.yml
  fi
  rm -f .github/workflows/factory.yml.bak

  if [ -n "$INSTALL_CI" ] && [ ! -f .github/workflows/ci.yml ]; then
    cp "$TEMPLATES_DIR/workflows/ci.yml" .github/workflows/ci.yml
  fi

  if [ ! -f CLAUDE.md ]; then
    if [ -n "$PROJECT_DIR" ] && [ -f "$PROJECT_DIR/CLAUDE.md" ]; then
      cp "$PROJECT_DIR/CLAUDE.md" CLAUDE.md
    else
      sed -e "s|__NAME__|${REPO#*/}|" "$TEMPLATES_DIR/CLAUDE.md" > CLAUDE.md
    fi
  fi

  mkdir -p .claude/hooks
  [ -f .claude/settings.json ] || cp "$TEMPLATES_DIR/claude/settings.json" .claude/settings.json
  [ -f .claude/hooks/session-start.sh ] || cp "$TEMPLATES_DIR/claude/hooks/session-start.sh" .claude/hooks/session-start.sh
  chmod +x .claude/hooks/session-start.sh
}

cmd_install() {
  [ $# -eq 1 ] || die "usage: factory install <alias>"
  load "$1"
  WORK="$(mktemp -d)"
  trap 'rm -rf "$WORK"' EXIT
  info "cloning $REPO"
  gh repo clone "$REPO" "$WORK/repo" -- --depth 1 -q
  cd "$WORK/repo"
  git checkout -q -b factory/install

  overlay

  git add -A
  if git diff --cached --quiet; then
    info "$REPO already has everything; nothing to commit"
  else
    git commit -q -m "Wire into tone-zone-software-factory

Adds the Factory workflow (Claude implements issues labeled '$LABEL', answers @claude,
and fixes CI on its own branches), CLAUDE.md, and a cloud-session setup hook."
    git push -q -u origin factory/install
    gh pr create -R "$REPO" --head factory/install --title "Wire into the software factory" --body "$(cat <<EOF
Installed by [tone-zone-software-factory](https://github.com/tonyjmartinez/tone-zone-software-factory).

- \`.github/workflows/factory.yml\`: label an issue \`$LABEL\` (or mention @claude) and Claude opens a PR; comment @claude on a PR to change it; when **$CI_WORKFLOW** fails on a \`claude/*\` branch, Claude fixes it (3 tries max).
$( [ -f .github/workflows/ci.yml ] && echo "- \`.github/workflows/ci.yml\`: generic Node CI (typecheck/check/lint/test/build, whichever exist)." )
- \`CLAUDE.md\`: what every Claude run reads first. Edit freely.
- \`.claude/\`: installs deps at the start of Claude Code cloud sessions so web/mobile/scheduled runs can test immediately.

Before merging: make sure the \`CLAUDE_CODE_OAUTH_TOKEN\` secret exists (\`factory doctor ${ALIAS}\`).
EOF
)"
  fi

  gh label create "$LABEL" -R "$REPO" --color D97757 --description "Claude implements this and opens a PR" --force >/dev/null
  info "label '$LABEL' ready"
  cd - >/dev/null
  cmd_doctor "$1" || true
}

cmd_secret() {
  [ $# -eq 1 ] || die "usage: factory secret <alias|all>"
  local token="${CLAUDE_CODE_OAUTH_TOKEN:-}"
  if [ -z "$token" ]; then
    echo "Paste the token from \`claude setup-token\` (uses your Claude subscription, not API billing):"
    read -r -s token
    echo
  fi
  [ -n "$token" ] || die "no token"
  for a in $(targets "$1"); do
    load "$a"
    printf '%s' "$token" | gh secret set CLAUDE_CODE_OAUTH_TOKEN -R "$REPO"
    info "$REPO: secret set"
  done
}

cmd_doctor() {
  local rc=0
  for a in $(targets "${1:-all}"); do
    load "$a"
    echo "$a ($REPO)"
    if gh secret list -R "$REPO" 2>/dev/null | grep -qE '^(CLAUDE_CODE_OAUTH_TOKEN|ANTHROPIC_API_KEY)\b'; then
      echo "  ok   Claude credential secret"
    else
      echo "  MISS Claude credential secret  -> claude setup-token, then: factory secret $a"; rc=1
    fi
    if gh label list -R "$REPO" --search "$LABEL" --json name --jq '.[].name' 2>/dev/null | grep -qx "$LABEL"; then
      echo "  ok   '$LABEL' label"
    else
      echo "  MISS '$LABEL' label            -> factory install $a"; rc=1
    fi
    if gh api "repos/$REPO/contents/.github/workflows/factory.yml" >/dev/null 2>&1; then
      echo "  ok   factory.yml on default branch"
    else
      echo "  MISS factory.yml on default branch -> merge the 'Wire into the software factory' PR"; rc=1
    fi
    if gh api "repos/$REPO/installation" >/dev/null 2>&1; then
      echo "  ok   a GitHub App is installed"
    else
      echo "  ?    Claude GitHub App: install at https://github.com/apps/claude so Claude's pushes trigger CI"
    fi
  done
  return $rc
}

cmd_task() {
  [ $# -ge 2 ] || die "usage: factory task <alias> \"what to do\" [details]"
  load "$1"
  local title="$2" body="${3:-$2}"
  gh issue create -R "$REPO" --title "$title" --body "$body" --label "$LABEL"
}

cmd_status() {
  for a in $(targets "${1:-all}"); do
    load "$a"
    echo "── $a ($REPO)"
    gh issue list -R "$REPO" --label "$LABEL" --state open \
      --json number,title --jq '.[] | "  issue #\(.number)  \(.title)"' 2>/dev/null || true
    gh pr list -R "$REPO" --state open --search "head:claude/" \
      --json number,title,url --jq '.[] | "  PR    #\(.number)  \(.title)  \(.url)"' 2>/dev/null || true
  done
}

# Claude settings that enforce the command's allowed-tools with a PreToolUse hook. Local Claude
# sessions can run with looser permissions than GitHub Actions; this makes them match.
guard_settings() {
  local cmd_file="$FACTORY_DIR/plugin/commands/$1.md"
  node -e 'const [g, c] = process.argv.slice(1); console.log(JSON.stringify({ hooks: { PreToolUse: [{ matcher: "*", hooks: [{ type: "command", command: `node "${g}" "${c}"` }] }] } }))' \
    "$FACTORY_DIR/bin/lib/guard.mjs" "$cmd_file"
}

# Runs a factory plugin command against a disposable copy of a project, the way GitHub Actions
# would, then audits permissions and re-verifies independently.
#   agent_run <command> <target> [options] <args...>
agent_run() {
  local command="$1" target="$2"; shift 2
  local from="" model="sonnet" max_turns=80 ship="" args=()
  while [ $# -gt 0 ]; do
    case "$1" in
      --from) from="$2"; shift 2 ;;
      --model) model="$2"; shift 2 ;;
      --max-turns) max_turns="$2"; shift 2 ;;
      --ship) ship=1; shift ;;
      *) args+=("$1"); shift ;;
    esac
  done
  command -v claude >/dev/null || die "install Claude Code: https://claude.com/claude-code"

  if [ -d "$target" ]; then
    from="$(cd "$target" && pwd)"
    ALIAS="$(basename "$from")" PROJECT_DIR="" REPO="" SETUP="" CI_WORKFLOW="CI" INSTALL_CI=""
    [ -f "$PROJECTS_DIR/$ALIAS/project.env" ] && load "$ALIAS"
  else
    load "$target"
  fi

  local runs="${FACTORY_RUNS_DIR:-${XDG_CACHE_HOME:-$HOME/.cache}/factory/runs}"
  local out; out="$runs/$(date +%Y%m%d-%H%M%S)-$ALIAS-$command"
  local work="$out/repo"
  mkdir -p "$out"

  if [ -n "$ship" ]; then
    need_gh
    [ -n "$REPO" ] || die "--ship needs a registered project or owner/repo"
    info "cloning $REPO (ship mode: the agent will push and open a PR)"
    gh repo clone "$REPO" "$work" -- -q
  elif [ -n "$from" ]; then
    info "copying $from"
    cp -a "$from" "$work"
  else
    need_gh
    info "cloning $REPO"
    gh repo clone "$REPO" "$work" -- --depth 1 -q
  fi

  cd "$work"
  if [ -z "$ship" ]; then
    # Trial run: cut the copy loose so nothing can reach the real repo, then add the factory files
    # as `factory install` would and snapshot that as the baseline the agent's diff is measured from.
    git remote | xargs -r -n1 git remote remove
    overlay
    git add -A
    git -c user.name=factory -c user.email=factory@localhost commit -q -m "factory: local baseline" --allow-empty --no-verify
  fi

  if [ -f package.json ] && [ ! -d node_modules ]; then
    info "installing dependencies"
    if [ -n "$SETUP" ]; then bash -c "$SETUP"; elif [ -f package-lock.json ]; then npm ci --no-audit --no-fund; else npm install --no-audit --no-fund; fi >"$out/setup.log" 2>&1 \
      || { tail -20 "$out/setup.log"; die "dependency install failed (see $out/setup.log)"; }
  fi

  local prompt="/factory:$command ${ship:+ship }${args[*]}"
  info "claude -p \"$prompt\" (model $model, max $max_turns turns)"
  # Project/local settings only: the agent shouldn't pick up your personal hooks or permissions.
  claude -p "$prompt" \
    --plugin-dir "$FACTORY_DIR/plugin" \
    --setting-sources project,local \
    --settings "$(guard_settings "$command")" \
    --model "$model" --max-turns "$max_turns" \
    --output-format stream-json --verbose > "$out/transcript.jsonl" 2>"$out/claude.stderr" || true

  # FACTORY_QUIET=1 (set by the Night shift workflow) keeps project content out of public CI logs:
  # only status lines are printed; the full report is in the PR and in $out.
  local rc=0
  if [ -n "${FACTORY_QUIET:-}" ]; then
    node "$FACTORY_DIR/bin/lib/report.mjs" "$out/transcript.jsonl" "$FACTORY_DIR/plugin/commands/$command.md" > "$out/report.txt" || rc=$?
    grep -E '^(result|turns|tools|permissions):|^permission gaps' "$out/report.txt" || true
  else
    node "$FACTORY_DIR/bin/lib/report.mjs" "$out/transcript.jsonl" "$FACTORY_DIR/plugin/commands/$command.md" || rc=$?
  fi

  echo "──────── independent verify ────────"
  if bash "$FACTORY_DIR/plugin/scripts/verify.sh" "$work" >"$out/verify.log" 2>&1; then
    echo "verify: pass ($(tail -1 "$out/verify.log"))"
  else
    echo "verify: FAIL"; [ -n "${FACTORY_QUIET:-}" ] || tail -15 "$out/verify.log"; [ "$rc" -ne 0 ] || rc=1
  fi

  echo "──────── changes ────────"
  git add -A -N . 2>/dev/null || true
  if [ -n "$ship" ]; then
    git --no-pager log --oneline "@{u}..HEAD" 2>/dev/null | head -5 || true
    git --no-pager log --oneline -3
  else
    git --no-pager diff --stat HEAD | tail -20
  fi
  git diff HEAD > "$out/changes.diff" || true
  echo
  info "workspace: $work"
  info "diff: $out/changes.diff   transcript: $out/transcript.jsonl"
  return $rc
}

cmd_run() { [ $# -ge 2 ] || die 'usage: factory run <alias|dir> [options] "what to do"'; agent_run implement "$@"; }
cmd_fix_ci() {
  [ $# -ge 2 ] || die "usage: factory fix-ci <alias|dir> [options] <log file>"
  local t="$1"; shift
  local a=() log=""
  for x in "$@"; do if [ -f "$x" ]; then log="$(cd "$(dirname "$x")" && pwd)/$(basename "$x")"; a+=("$log"); else a+=("$x"); fi; done
  [ -n "$log" ] || die "log file not found"
  agent_run fix-ci "$t" "${a[@]}"
}

# Reviews uncommitted changes in place (read-only command, no copy needed).
cmd_review() {
  [ $# -ge 1 ] && [ -d "$1" ] || die "usage: factory review <dir>"
  cd "$1"
  local out; out="$(mktemp)"
  claude -p "/factory:review" --plugin-dir "$FACTORY_DIR/plugin" --setting-sources project,local \
    --settings "$(guard_settings review)" \
    --model "${FACTORY_REVIEW_MODEL:-sonnet}" --max-turns 30 --output-format stream-json --verbose > "$out" 2>/dev/null || true
  node "$FACTORY_DIR/bin/lib/report.mjs" "$out" "$FACTORY_DIR/plugin/commands/review.md"
}

# One night's unit of work for a project: its NIGHTLY routine (routines/<name>.md) in ship mode.
# Back-pressure: skips while a previous claude/night-* PR there is still open, so unreviewed work
# never piles up and a waiting night costs nothing. --trial runs it locally without pushing.
cmd_night() {
  [ $# -ge 1 ] || die "usage: factory night <alias> [--trial] [--from DIR] [--model M] [--max-turns N]"
  local alias="$1"; shift
  load "$alias"
  [ -n "$NIGHTLY" ] || { info "$alias: no NIGHTLY routine in project.env; nothing to do"; return 0; }
  local routine="$FACTORY_DIR/routines/$NIGHTLY.md"
  [ -f "$routine" ] || die "$alias: routine file routines/$NIGHTLY.md not found"
  local trial="" rest=()
  for a in "$@"; do if [ "$a" = --trial ]; then trial=1; else rest+=("$a"); fi; done

  if [ -z "$trial" ]; then
    local open
    open=$(gh pr list -R "$REPO" --state open --json headRefName \
      --jq '[.[] | select(.headRefName | startswith("claude/night-"))] | length') || die "$alias: can't list PRs on $REPO"
    if [ "$open" -gt 0 ]; then
      info "$alias: $open night-shift PR(s) still open on $REPO; waiting for review"
      return 0
    fi
  fi

  local task; task="$(sed '1s|^/factory:implement ship ||' "$routine")"
  info "$alias: routine $NIGHTLY${trial:+ (trial: no push)}"
  local mode=(--ship); [ -z "$trial" ] || mode=()
  agent_run implement "$alias" ${mode[@]+"${mode[@]}"} --model "${NIGHTLY_MODEL:-sonnet}" \
    --max-turns "${NIGHTLY_MAX_TURNS:-60}" ${rest[@]+"${rest[@]}"} "$task"
}

# JSON list of projects with a NIGHTLY routine (all, or just the one named), for the workflow matrix.
cmd_nightly_projects() {
  local list=()
  for a in $(targets "${1:-all}"); do load "$a"; [ -n "$NIGHTLY" ] && list+=("\"$a\""); done
  local IFS=,; echo "[${list[*]}]"
}

main() {
  local cmd="${1:-help}"; shift || true
  case "$cmd" in
    list|ls|nightly-projects|review|help|-h|--help) ;;
    run|fix-ci) ;; # need gh only when cloning; checked there
    *) need_gh ;;
  esac
  case "$cmd" in
    list|ls) cmd_list ;;
    add) cmd_add "$@" ;;
    install) cmd_install "$@" ;;
    secret) cmd_secret "$@" ;;
    doctor) cmd_doctor "$@" ;;
    task|t) cmd_task "$@" ;;
    status|st) cmd_status "$@" ;;
    run) cmd_run "$@" ;;
    fix-ci) cmd_fix_ci "$@" ;;
    review) cmd_review "$@" ;;
    night) cmd_night "$@" ;;
    nightly-projects) cmd_nightly_projects "$@" ;;
    help|-h|--help) sed -n '2,21p' "$0" | sed 's/^# \{0,1\}//' ;;
    *) die "unknown command '$cmd' (try: factory help)" ;;
  esac
}

main "$@"
