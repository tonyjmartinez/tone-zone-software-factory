# Read by bin/factory. Alias is the directory name.
REPO=tonyjmartinez/succulents.info
# Name of the project's existing CI workflow; Factory auto-fixes Claude branches when it fails.
CI_WORKFLOW="Check and deploy"
SETUP="npm ci"
# Night shift (.github/workflows/night-shift.yml): routine from routines/, model, turn cap.
NIGHTLY=polish
NIGHTLY_MODEL=sonnet
NIGHTLY_MAX_TURNS=40
