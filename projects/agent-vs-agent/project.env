REPO=tonyjmartinez/agent-vs-agent
# Greenfield: only PLAN.md exists. The installer adds the generic CI; Phase 0 of the plan
# creates package.json, after which CI runs whatever check/lint/test/build scripts exist.
CI_WORKFLOW=CI
INSTALL_CI=1
# Night shift (.github/workflows/night-shift.yml): routine from routines/, model, turn cap.
NIGHTLY=build-next-phase
NIGHTLY_MODEL=sonnet
NIGHTLY_MAX_TURNS=100
